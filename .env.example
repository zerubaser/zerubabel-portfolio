# =============================================================================
# zerubabel.et — Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit your real .env.
# All values below are intentionally EMPTY. Do not put secrets in this file.
# =============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# In production, include schema and a low connection limit, e.g.:
#   postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public&connection_limit=5
# Use plain String/String? in the Prisma schema (Postgres text is unlimited).
DATABASE_URL=

# --- Auth.js / NextAuth (v5) --------------------------------------------------
# Secret used to sign/encrypt JWT sessions. Generate a strong random value, e.g.
#   npx auth secret      (or: openssl rand -base64 33)
# Credentials provider MUST use JWT sessions (no DB session tables).
# Auth.js v5 reads AUTH_SECRET (NEXTAUTH_SECRET is accepted as a fallback).
AUTH_SECRET=
NEXTAUTH_SECRET=

# Canonical URL of the deployment, e.g. https://zerubabel.et (or http://localhost:3000 in dev).
# Behind Nginx/PM2 in production, also set AUTH_TRUST_HOST=true.
NEXTAUTH_URL=
AUTH_TRUST_HOST=

# --- Admin bootstrap ----------------------------------------------------------
# Initial admin login credentials (used to seed/sign in to the admin dashboard).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Uploads ------------------------------------------------------------------
# Absolute path where uploaded files are stored (must be OUTSIDE the app deploy
# folder in production). Allowed: jpg, jpeg, png, webp, pdf (resume/docs only).
# Images are converted to WebP and resized to <=1920px. SVG is blocked.
#   Local dev example:  UPLOAD_DIR="C:/laragon/www/zerubabel.et/uploads"
#   Production example:  UPLOAD_DIR="/var/www/zerubabel.et/uploads"
UPLOAD_DIR="/var/www/zerubabel.et/uploads"

# Public base URL for uploads. Stored ProjectImage URLs are origin-relative
# ("/uploads/..."); this value is for building ABSOLUTE URLs when needed (OG).
# In dev, Next serves /uploads/* via a route handler; in prod, Nginx serves it.
#   Local dev example:  UPLOAD_PUBLIC_URL="http://localhost:3000/uploads"
#   Production example:  UPLOAD_PUBLIC_URL="https://zerubabel.et/uploads"
UPLOAD_PUBLIC_URL="https://zerubabel.et/uploads"

# --- Contact form / email -----------------------------------------------------
# Address that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=

# SMTP transport for outgoing email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
