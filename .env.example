# =============================================================================
# zerubabel.et — Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit your real .env.
# All values below are intentionally EMPTY. Do not put secrets in this file.
# =============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# In production, include schema and a low connection limit, e.g.:
#   postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public&connection_limit=5
# Use plain String/String? in the Prisma schema (Postgres text is unlimited).
DATABASE_URL=

# --- Auth.js / NextAuth -------------------------------------------------------
# Secret used to sign/encrypt JWT sessions. Generate a strong random value.
# Credentials provider MUST use JWT sessions (no DB session tables).
NEXTAUTH_SECRET=

# Canonical URL of the deployment, e.g. https://zerubabel.et (or http://localhost:3000 in dev).
NEXTAUTH_URL=

# --- Admin bootstrap ----------------------------------------------------------
# Initial admin login credentials (used to seed/sign in to the admin dashboard).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Uploads ------------------------------------------------------------------
# Absolute path on the server where uploaded files are stored.
# Allowed: jpg, jpeg, png, webp, pdf (resume only). Images compressed to WebP.
UPLOAD_DIR="/var/www/zerubabel.et/uploads"

# Public base URL where Nginx serves uploaded files directly (no Next optimization).
UPLOAD_PUBLIC_URL="https://zerubabel.et/uploads"

# --- Contact form / email -----------------------------------------------------
# Address that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=

# SMTP transport for outgoing email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
